# Copy this file to .env.local and fill in your own values.
# Do NOT put real keys in this file, and do NOT commit .env.local.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (public key only, never the service role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Do NOT put the Supabase service role key in a browser app.
# If server code ever needs it, keep it in server-only env vars.
# SUPABASE_SERVICE_ROLE_KEY=
